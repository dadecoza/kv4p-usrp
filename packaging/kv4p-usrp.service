[Unit]
Description=KV4P-HT to AllStarLink USRP bridge
Documentation=https://github.com/dadecoza/kv4p-usrp
Wants=network-online.target
After=network-online.target asterisk.service

[Service]
Type=exec
User=kv4p-usrp
Group=kv4p-usrp
SupplementaryGroups=dialout
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/default/kv4p-usrp
ExecStart=/opt/kv4p-usrp/.venv/bin/python /opt/kv4p-usrp/kv4p_usrp.py $KV4P_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# The bridge needs the serial device and UDP sockets, but no writable system files.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
